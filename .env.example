# Energy Management SaaS - Environment Variables Template
# Copy this file to .env.local and fill in your values for development
# NEVER commit .env or .env.production to git

# ==========================================
# Database (MySQL)
# ==========================================
DATABASE_URL="mysql://dev_user:dev_password@localhost:3306/energy_mgmt_dev"

# ==========================================
# NextAuth Configuration
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[generate with: openssl rand -base64 32]"

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET="[generate with: openssl rand -base64 32]"

# ==========================================
# AI Engine (FastAPI)
# ==========================================
AI_ENGINE_URL="http://localhost:8001"
AI_ENGINE_API_KEY="dev-secret-key-32-chars-minimum-length!"

# ==========================================
# Application
# ==========================================
NODE_ENV="development"
WEB_APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# ==========================================
# Optional: Redis (for rate limiting, sessions)
# ==========================================
# REDIS_URL="redis://localhost:6379"
# REDIS_TOKEN="your-token"

# ==========================================
# Optional: AWS/Cloud Services
# ==========================================
# AWS_REGION="ap-northeast-2"
# AWS_ACCESS_KEY_ID="your-key"
# AWS_SECRET_ACCESS_KEY="your-secret"
