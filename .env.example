# Energy Management SaaS - Environment Variables Template
# Copy this file to .env.local and fill in your values for development
# NEVER commit .env or .env.production to git

# ==========================================
# Database (MySQL)
# ==========================================
# 개발 환경용 데이터베이스 연결 문자열
# 프로덕션에서는 보안 그룹과 VPC로 보호된 DB 사용 권장
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"

# ==========================================
# NextAuth Configuration
# ==========================================
# NextAuth URL (프로덕션에서는 실제 도메인으로 변경)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret (최소 32자 이상의 랜덤 문자열 필수)
# 생성 방법: openssl rand -base64 32
NEXTAUTH_SECRET="ZVVOr7LX0ys8caXa+O7oj0wYsEEkrTqg6ycCq/HzTm8="

# ==========================================
# JWT Configuration
# ==========================================
# JWT Secret (최소 32자 이상의 랜덤 문자열 필수)
# 생성 방법: openssl rand -base64 32
# ⚠️ NEXTAUTH_SECRET과 다른 값을 사용해야 합니다
JWT_SECRET="WhToneM4EuOYneZkwGqYcJBY63pkLj2JYzXc5xhfkbY="

# ==========================================
# AI Engine (FastAPI)
# ==========================================
# AI 엔진 서버 URL
AI_ENGINE_URL="http://localhost:8001"

# AI 엔진 API 키 (최소 32자 이상)
# 생성 방법: openssl rand -hex 32
AI_ENGINE_API_KEY="9768b5fa3b082a087c44370eefa1a56972e98ed3165670ed6453410b0886d8ad"

# ==========================================
# Application
# ==========================================
NODE_ENV="development"
WEB_APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# 사이트 URL (SEO 메타데이터용, 프로덕션 도메인으로 변경)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==========================================
# Optional: OAuth (Google)
# ==========================================
# Google Cloud Console에서 OAuth 클라이언트 ID 생성 필요
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==========================================
# Optional: OAuth (Naver)
# ==========================================
# 네이버 개발자 센터에서 애플리케이션 등록 필요
# https://developers.naver.com/apps
# NAVER_CLIENT_ID="your-naver-client-id"
# NAVER_CLIENT_SECRET="your-naver-client-secret"

# ==========================================
# Optional: Redis (for rate limiting, sessions)
# ==========================================
# Upstash Redis 또는 자체 Redis 서버 사용
# https://upstash.com/
# REDIS_URL="redis://username:password@host:port"
# REDIS_TOKEN="your-upstash-token"

# ==========================================
# Optional: AWS/Cloud Services
# ==========================================
# AWS 리소스 사용 시 필요 (S3, SES 등)
# IAM 사용자 생성 및 최소 권한 부여 권장
# AWS_REGION="ap-northeast-2"
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# ==========================================
# Optional: Email (SendGrid, AWS SES 등)
# ==========================================
# 비밀번호 재설정, 알림 이메일 발송용
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="noreply@yourdomain.com"

# ==========================================
# Payment (토스페이먼츠)
# ==========================================
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_..."
TOSS_SECRET_KEY="test_sk_..."

# ==========================================
# MQTT
# ==========================================
# 로컬 개발: 빈값으로 비활성화
MQTT_BROKER_URL=""
MQTT_USER="ems"
MQTT_PASSWORD="mqttpassword"

# ==========================================
# Redis
# ==========================================
# 로컬 개발: 빈값으로 비활성화 (세션/Rate-Limit 메모리 폴백)
REDIS_URL=""

# ==========================================
# Docker / 프로덕션 인프라
# ==========================================
MYSQL_ROOT_PASSWORD="changeme-rootpassword"
MYSQL_DATABASE="energy"
MYSQL_USER="ems"
MYSQL_PASSWORD="changeme-emspassword"
REDIS_PASSWORD="changeme-redispassword"
GRAFANA_USER="admin"
GRAFANA_PASSWORD="changeme-grafanapassword"
GRAFANA_DOMAIN="grafana.carboneum.kr"
CRON_SECRET="changeme-cron-secret-32chars"

# ==========================================
# Backup
# ==========================================
# 로컬 백업 기본 저장 경로 (미설정 시: {project_root}/backups/)
# 운영 환경: BACKUP_DIR=/var/backups/tansoeum
# BACKUP_DIR="/var/backups/tansoeum"

# ==========================================
# Optional: Monitoring & Analytics
# ==========================================
# Sentry (에러 트래킹)
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ==========================================
# 보안 권장 사항
# ==========================================
# Security & Monitoring
# ==========================================
# 보안 이벤트 HIGH/CRITICAL 알림 수신 이메일
SECURITY_ALERT_EMAIL="security@carboneum.kr"

# ==========================================
# SEO & Webmaster Verification
# ==========================================
# Google Search Console 소유권 인증 코드
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Naver 웹마스터 소유권 인증 코드
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""
# 사이트 기본 URL (sitemap, OG 이미지 등에 사용)
NEXT_PUBLIC_SITE_URL="https://carboneum.kr"
# 고객 지원 이메일 (Organization 구조화 데이터)
NEXT_PUBLIC_SUPPORT_EMAIL="support@carboneum.kr"

# ==========================================
# 보안 권장 사항
# ==========================================
# 1. 모든 SECRET, PASSWORD, KEY는 최소 32자 이상 사용
# 2. 개발/스테이징/프로덕션 환경별로 다른 값 사용
# 3. Git에 절대 커밋하지 말 것 (.gitignore 확인)
# 4. 프로덕션 환경에서는 환경 변수 관리 서비스 사용 권장
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Vercel/Netlify Environment Variables
# 5. 정기적으로 시크릿 로테이션 (3~6개월)
