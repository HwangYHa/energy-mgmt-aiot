# 🔒 PRODUCTION ENVIRONMENT VARIABLES
# ⚠️  NEVER COMMIT THIS FILE TO GIT
# Use AWS Secrets Manager or similar secure storage in production

# ==========================================
# Database (Production RDS)
# ==========================================
DATABASE_URL="mysql://prod_user:[SECURE_PASSWORD]@prod-db.xxxxx.rds.amazonaws.com:3306/energy_mgmt"

# ==========================================
# NextAuth Configuration
# ==========================================
NEXTAUTH_URL="https://app.yourdomain.com"
NEXTAUTH_SECRET="[GENERATE: openssl rand -base64 32]"

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET="[GENERATE: openssl rand -base64 32]"

# ==========================================
# AI Engine (Production)
# ==========================================
AI_ENGINE_URL="https://ai-engine.internal:8001"
AI_ENGINE_API_KEY="[MINIMUM 32 CHARS - USE SECURE RANDOM]"

# ==========================================
# Application
# ==========================================
NODE_ENV="production"
WEB_APP_URL="https://app.yourdomain.com"
LOG_LEVEL="info"

# ==========================================
# Optional: AWS Services
# ==========================================
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="[FROM IAM USER]"
AWS_SECRET_ACCESS_KEY="[FROM IAM USER]"

# ==========================================
# Optional: Redis (Managed ElastiCache)
# ==========================================
REDIS_URL="redis://prod-redis.xxxxx.ng.0001.apn2.cache.amazonaws.com:6379"
REDIS_TOKEN="[IF REQUIRED]"
