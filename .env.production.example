# 🔒 PRODUCTION ENVIRONMENT VARIABLES - TEMPLATE
# ⚠️  NEVER COMMIT REAL PRODUCTION VALUES TO GIT
#
# 프로덕션 배포 시 권장 사항:
# 1. AWS Secrets Manager, HashiCorp Vault 등 시크릿 관리 서비스 사용
# 2. 환경 변수를 CI/CD 파이프라인에서 주입
# 3. 모든 시크릿은 개발 환경과 완전히 다른 값 사용
# 4. 정기적으로 시크릿 로테이션 (3~6개월)

# ==========================================
# Database (Production RDS)
# ==========================================
# AWS RDS 또는 관리형 MySQL 데이터베이스 사용 권장
# - VPC 내부에서만 접근 가능하도록 설정
# - SSL/TLS 연결 필수
# - 자동 백업 및 Point-in-Time Recovery 활성화
DATABASE_URL="mysql://prod_user:[STRONG_PASSWORD]@prod-db-hostname.region.rds.amazonaws.com:3306/energy_mgmt"

# ==========================================
# NextAuth Configuration
# ==========================================
# 실제 프로덕션 도메인 사용 (HTTPS 필수)
NEXTAUTH_URL="https://app.yourdomain.com"

# NextAuth Secret (최소 64자 이상 권장)
# 생성 방법: openssl rand -base64 64
# ⚠️ 개발 환경과 다른 값 사용 필수
NEXTAUTH_SECRET="ZVVOr7LX0ys8caXa+O7oj0wYsEEkrTqg6ycCq/HzTm8="

# ==========================================
# JWT Configuration
# ==========================================
# JWT Secret (최소 64자 이상 권장)
# 생성 방법: openssl rand -base64 64
# ⚠️ NEXTAUTH_SECRET과 완전히 다른 값 사용 필수
JWT_SECRET="WhToneM4EuOYneZkwGqYcJBY63pkLj2JYzXc5xhfkbY="

# ==========================================
# AI Engine (Production)
# ==========================================
# AI 엔진을 VPC 내부 또는 Private Network에 배치 권장
# API Gateway + Lambda 또는 ECS/EKS 사용
AI_ENGINE_URL="https://ai-engine-internal.yourdomain.com"

# AI 엔진 API 키 (최소 64자 이상)
# 생성 방법: openssl rand -hex 64
AI_ENGINE_API_KEY="9768b5fa3b082a087c44370eefa1a56972e98ed3165670ed6453410b0886d8ad"

# ==========================================
# Application
# ==========================================
NODE_ENV="production"
WEB_APP_URL="https://app.yourdomain.com"
LOG_LEVEL="warn"  # 프로덕션에서는 warn 또는 error 권장

# ==========================================
# OAuth (Google) - Production
# ==========================================
# Google Cloud Console에서 프로덕션용 OAuth 클라이언트 별도 생성
# Authorized redirect URIs: https://app.yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-production-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[FROM_GOOGLE_CLOUD_CONSOLE]"

# ==========================================
# OAuth (Naver) - Production
# ==========================================
# 네이버 개발자 센터에서 프로덕션용 애플리케이션 별도 등록
NAVER_CLIENT_ID="[FROM_NAVER_DEVELOPERS]"
NAVER_CLIENT_SECRET="[FROM_NAVER_DEVELOPERS]"

# ==========================================
# Redis (AWS ElastiCache 또는 Upstash)
# ==========================================
# 레이트 리미팅, 세션 캐싱용
# AWS ElastiCache for Redis 권장 (VPC 내부)
REDIS_URL="rediss://prod-redis-cluster.region.cache.amazonaws.com:6379"
REDIS_TOKEN="[IF_USING_UPSTASH_OR_AUTH_REQUIRED]"

# ==========================================
# AWS Services
# ==========================================
# IAM Role 사용 권장 (EC2, ECS, Lambda 등)
# 직접 키 사용 시 최소 권한 원칙 적용
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="[IAM_USER_ACCESS_KEY]"
AWS_SECRET_ACCESS_KEY="[IAM_USER_SECRET_KEY]"

# S3 버킷 (리포트 저장용)
AWS_S3_BUCKET_NAME="energy-mgmt-reports-prod"
AWS_S3_REGION="ap-northeast-2"

# ==========================================
# Email Service (AWS SES 또는 SendGrid)
# ==========================================
# 비밀번호 재설정, 알림 이메일 발송용
SMTP_HOST="email-smtp.ap-northeast-2.amazonaws.com"
SMTP_PORT="587"
SMTP_USER="[AWS_SES_SMTP_USERNAME]"
SMTP_PASSWORD="[AWS_SES_SMTP_PASSWORD]"
EMAIL_FROM="noreply@yourdomain.com"

# ==========================================
# Monitoring & Error Tracking
# ==========================================
# Sentry (에러 추적)
NEXT_PUBLIC_SENTRY_DSN="https://[public-key]@o[org-id].ingest.sentry.io/[project-id]"
SENTRY_AUTH_TOKEN="[SENTRY_AUTH_TOKEN]"

# Datadog (APM, 로그 수집)
# DD_API_KEY="[DATADOG_API_KEY]"
# DD_SITE="datadoghq.com"

# ==========================================
# Analytics
# ==========================================
# Google Analytics (프로덕션 전용 Property)
NEXT_PUBLIC_GA_ID="G-[PRODUCTION_MEASUREMENT_ID]"

# ==========================================
# Rate Limiting
# ==========================================
# Upstash Redis 사용 시
UPSTASH_REDIS_REST_URL="https://[upstash-endpoint].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[UPSTASH_TOKEN]"

# ==========================================
# 보안 체크리스트 (배포 전 필수 확인)
# ==========================================
# ✅ 모든 SECRET, KEY는 개발 환경과 다른 값 사용
# ✅ DATABASE_URL에 강력한 비밀번호 설정 (특수문자 포함)
# ✅ HTTPS 강제 적용 (HSTS 헤더 활성화)
# ✅ CORS 설정 검토 (허용 도메인 제한)
# ✅ CSP 헤더 엄격하게 설정
# ✅ Rate Limiting 활성화 (Redis 필수)
# ✅ 로그에 민감 정보 노출 방지 (LOG_LEVEL=warn)
# ✅ DB 백업 자동화 설정
# ✅ 모니터링 및 알림 설정 (Sentry, CloudWatch)
# ✅ WAF (Web Application Firewall) 적용 (AWS WAF, Cloudflare)
# ✅ DDoS 방어 설정
# ✅ 정기 보안 업데이트 및 취약점 스캔
