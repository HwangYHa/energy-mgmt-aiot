# ────────────────────────────────────────────────────────────────
# 탄소이음 Collector Service — 환경변수 예시
# cp .env.example .env 후 실제 값으로 수정
# ────────────────────────────────────────────────────────────────

# 클라우드 API (필수)
CLOUD_API_URL=https://your-server.com
GATEWAY_ID=gw_xxxxxxxxxxxxxxxx
GATEWAY_TOKEN=your_gateway_token_here

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# 설정 파일 경로 (기본: ./config/config.yaml)
# COLLECTOR_CONFIG=/etc/collector/config.yaml