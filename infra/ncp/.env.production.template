# ============================================================
# 탄소이음 EMS AIoT — 프로덕션 환경변수 템플릿
# 파일명: .env.production
# 위치: /opt/ems-aiot/.env.production (서버 전용 — git 미포함)
#
# 생성 방법:
#   cp infra/ncp/.env.production.template /opt/ems-aiot/.env.production
#   vim /opt/ems-aiot/.env.production
#
# 주의: 이 파일은 절대 git에 커밋하지 마세요
# ============================================================


# ============================================================
# NCP / 배포 설정
# ============================================================
NCP_REGISTRY=ncr.kr-standard.ncr.gov-ncloud.com/ems-aiot
NCP_ACCESS_KEY=                             # NCP API Access Key
NCP_SECRET_KEY=                             # NCP API Secret Key
APP_VERSION=latest                          # 배포 시 자동 주입 (git SHA)


# ============================================================
# 데이터베이스
# ============================================================
DATABASE_URL=mysql://ems:CHANGE_ME_DB_PASS@mysql:3306/energy
MYSQL_DATABASE=energy
MYSQL_USER=ems
MYSQL_PASSWORD=CHANGE_ME_DB_PASS           # 32자 이상 랜덤 문자열
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASS    # 별도 루트 비밀번호


# ============================================================
# Redis
# ============================================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS        # 32자 이상 랜덤 문자열


# ============================================================
# 애플리케이션 URL (도메인 구매 후 설정)
# ============================================================
NEXTAUTH_URL=https://carbonieum.co.kr
WEB_APP_URL=https://carbonieum.co.kr
NEXT_PUBLIC_APP_URL=https://carbonieum.co.kr
NEXT_PUBLIC_SITE_URL=https://carbonieum.co.kr


# ============================================================
# 인증 보안키 (운영 전용 — 개발 키 절대 사용 금지)
# 생성: openssl rand -base64 48
# ============================================================
NEXTAUTH_SECRET=                            # 48자 이상 base64
JWT_SECRET=                                 # 48자 이상 base64


# ============================================================
# Google OAuth
# https://console.cloud.google.com → 사용자 인증 정보
# Redirect URI: https://carbonieum.co.kr/api/auth/callback/google
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ============================================================
# Naver OAuth
# https://developers.naver.com → 애플리케이션 등록
# Redirect URI: https://carbonieum.co.kr/api/auth/oauth/naver/callback
# ============================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://carbonieum.co.kr/api/auth/oauth/naver/callback


# ============================================================
# MQTT
# mosquitto passwd 파일과 동일하게 설정
# ============================================================
MQTT_USERNAME=ems
MQTT_PASSWORD=CHANGE_ME_MQTT_PASS
MQTT_CLIENT_ID=energy-aiot-platform


# ============================================================
# IoT Gateway API Key
# 생성: openssl rand -base64 32
# ============================================================
GATEWAY_API_KEY=


# ============================================================
# 이메일 (Gmail SMTP)
# Google 계정 → 앱 비밀번호 (16자리, 공백 없이)
# ============================================================
GMAIL_USER=carbonieum.official@gmail.com
GMAIL_APP_PASSWORD=                         # 16자리 앱 비밀번호 (공백 제거)
SUPPORT_EMAIL=carbonieum.official@gmail.com
SECURITY_ALERT_EMAIL=carbonieum.official@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=carbonieum.official@gmail.com


# ============================================================
# 이메일 (AWS SES SMTP 보조)
# ============================================================
SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# ============================================================
# 결제 — Toss (라이브 키로 교체)
# ============================================================
NEXT_PUBLIC_TOSS_CLIENT_KEY=live_ck_       # 라이브 클라이언트 키
TOSS_SECRET_KEY=live_sk_                   # 라이브 시크릿 키


# ============================================================
# 결제 — Stripe (라이브 키로 교체)
# ⚠ Price ID는 price_xxx 형식 (prod_xxx 아님)
# Stripe Dashboard → Products → 상품 → Pricing 탭
# ============================================================
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_BASIC_MONTHLY_PRICE_ID=price_       # price_xxx
STRIPE_BASIC_YEARLY_PRICE_ID=price_        # price_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_         # price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_          # price_xxx


# ============================================================
# SMS / 카카오 알림톡 (Solapi)
# ============================================================
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=010-XXXX-XXXX
KAKAO_SENDER_KEY=
SOLAPI_KAKAO_CHANNEL_ID=


# ============================================================
# AI 엔진
# ============================================================
AI_ENGINE_URL=http://ai-engine:8001
ANTHROPIC_API_KEY=


# ============================================================
# 보안 / 크론
# 생성: openssl rand -hex 32
# ============================================================
CRON_SECRET=


# ============================================================
# 모니터링
# ============================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS    # 강력한 비밀번호


# ============================================================
# 백업
# ============================================================
BACKUP_DIR=/opt/backups/ems-mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=energy
DB_USER=ems
DB_PASS=CHANGE_ME_DB_PASS
RETAIN_DAYS=30


# ============================================================
# SEO / Analytics (도메인 확정 후 입력)
# ============================================================
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_NAVER_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_ID=
