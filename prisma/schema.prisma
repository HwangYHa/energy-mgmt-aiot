// ========================================
// CONTROL: 스케줄 제어
// ========================================

model ControlSchedule {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  deviceId String @map("device_id")

  // 기본 정보
  name        String  @db.VarChar(200)
  description String? @db.Text

  // 제어 명령
  action      String   @db.VarChar(100) // start, stop, setpoint
  parameters  Json?
  targetValue Decimal? @map("target_value") @db.Decimal(15, 4)

  // 스케줄 설정
  scheduleType ScheduleType @default(once) @map("schedule_type")
  cronExpr     String?      @map("cron_expr") @db.VarChar(100)
  startAt      DateTime     @map("start_at")
  endAt        DateTime?    @map("end_at")
  repeatDays   Json?        @map("repeat_days") // [0,1,2,3,4,5,6] (일~토)

  // 우선순위 / 충돌 방지
  priority     Int     @default(5) // 1(최고)~10(최저)
  allowOverlap Boolean @default(false) @map("allow_overlap")

  // 상태
  enabled    Boolean         @default(true)
  status     ScheduleStatus  @default(active)
  lastRunAt  DateTime?       @map("last_run_at")
  nextRunAt  DateTime?       @map("next_run_at")

  // 생성자
  createdBy String @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, deviceId])
  @@index([status, nextRunAt])
  @@index([deviceId, startAt])
  @@map("control_schedule")
}

enum ScheduleType {
  once
  daily
  weekly
  cron
}

enum ScheduleStatus {
  active
  paused
  completed
  expired
}

// ========================================
// COMPLIANCE: 배출계수 관리
// ========================================

model EmissionFactor {
  id       String @id @default(uuid())
  tenantId String? @map("tenant_id") // null = 글로벌 기본값

  // 식별
  name       String @db.VarChar(200)
  code       String @unique @db.VarChar(50)
  category   String @db.VarChar(50) // electricity, fuel, transport, process
  sourceType String @map("source_type") @db.VarChar(100) // 전력(한전), LNG, 경유 등

  // 계수 값
  factor     Decimal @db.Decimal(15, 8)
  unit       String  @db.VarChar(50) // tCO2eq/MWh, tCO2eq/TJ 등
  inputUnit  String  @map("input_unit") @db.VarChar(50) // kWh, L, kg 등

  // 출처
  source    String  @db.VarChar(200) // 국가 온실가스 인벤토리 등
  year      Int
  region    String  @default("KR") @db.VarChar(10)
  isDefault Boolean @default(false) @map("is_default")

  // 버전 관리
  version    Int      @default(1)
  validFrom  DateTime @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([tenantId])
  @@index([year, region])
  @@map("emission_factor")
}

