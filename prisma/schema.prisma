// ========================================
// SUPPORT: 문의 접수
// ========================================

model SupportInquiry {
  id String @id @default(uuid())

  // 문의 정보
  name     String @db.VarChar(200)
  email    String @db.VarChar(255)
  category String @db.VarChar(50)
  subject  String @db.VarChar(500)
  message  String @db.Text

  // 상태
  status String @default("pending") @db.VarChar(20) // pending, in_progress, resolved, closed

  // 연결 (로그인 사용자의 경우)
  tenantId String? @map("tenant_id")
  userId   String? @map("user_id")

  // 관리자 메모
  adminNote String? @map("admin_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt(sort: Desc)])
  @@map("support_inquiry")
}

// ========================================
// DIGITAL TWIN: 물리 공간 계층
// ========================================

enum SpaceType {
  building
  floor
  zone
  room
  shaft
}

model PhysicalSpace {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  siteId   String @map("site_id")

  // 기본 정보
  name String  @db.VarChar(200)
  code String? @db.VarChar(50)
  type SpaceType

  // 계층 (0=building, 1=floor, 2=zone, 3=room)
  level Int @default(0)

  // 자기참조 부모
  parentId String? @map("parent_id")

  // 평면도 좌표 (선택)
  floorPlanX Decimal? @map("floor_plan_x") @db.Decimal(10, 2)
  floorPlanY Decimal? @map("floor_plan_y") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent    PhysicalSpace?  @relation("SpaceChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  PhysicalSpace[] @relation("SpaceChildren")
  twinNodes TwinNode[]

  @@index([tenantId])
  @@index([siteId, type])
  @@index([parentId])
  @@map("physical_space")
}

// ========================================
// DIGITAL TWIN: 트윈 노드 (Device ↔ 공간 바인딩)
// ========================================

enum SystemType {
  HVAC
  ELECTRICAL
  PLUMBING
  FIRE_SAFETY
  LIGHTING
  MECHANICAL
  OTHER
}

enum EquipClass {
  AHU
  FCU
  CHILLER
  COOLING_TOWER
  BOILER
  PUMP
  FAN
  TRANSFORMER
  UPS
  PANEL
  METER
  SENSOR
  OTHER
}

model TwinNode {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  deviceId String @unique @map("device_id")
  spaceId  String @map("space_id")

  // 설비 분류
  systemType SystemType @map("system_type")
  equipClass EquipClass @map("equip_class")

  // 에너지 토폴로지 (downstream / upstream TwinNode ID 배열)
  feedsIds Json? @map("feeds_ids")
  fedByIds Json? @map("fed_by_ids")

  // 파생 메트릭 정의 (COP, 부하율 등 계산식 JSON)
  computedMetrics Json? @map("computed_metrics")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  space  PhysicalSpace @relation(fields: [spaceId], references: [id])

  @@index([tenantId])
  @@index([spaceId])
  @@index([systemType])
  @@map("twin_node")
}

// ========================================
// CARBON: 배출권 보유 현황
// ========================================

model CarbonCredit {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  // 크레딧 정보
  vintage  Int    // 크레딧 발행 연도 (예: 2024)
  type     String @db.VarChar(10) // "KAU" | "KCU" | "OFFSET"

  // 수량/가격
  quantity Float  // 보유 크레딧 수량 (tCO₂)
  avgCost  Float  @default(0) @map("avg_cost") // 평균 매입 단가 (KRW/tCO₂)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trades CarbonTrade[]

  @@index([tenantId, vintage])
  @@index([type])
  @@map("carbon_credit")
}

// ========================================
// CARBON: 배출권 거래 내역
// ========================================

model CarbonTrade {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  creditId String @map("credit_id")

  // 거래 정보
  tradeType   String  @map("trade_type") @db.VarChar(10) // "buy" | "sell" | "retire"
  quantity    Float   // 거래 수량 (tCO₂)
  price       Float   @default(0) // 단가 KRW/tCO₂ (retire은 0)
  totalAmount Float   @default(0) @map("total_amount") // quantity * price

  memo String? @db.Text

  tradedAt  DateTime @default(now()) @map("traded_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credit CarbonCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([tenantId, tradedAt(sort: Desc)])
  @@index([creditId])
  @@index([tradeType])
  @@map("carbon_trade")
}

// ========================================
// CARBON TRADING v2: 프로덕션 레지스트리 + 원장
// ========================================

/// 탄소 크레딧 레지스트리 (불변 자산 레코드)
/// K-ETS / Verra / Gold Standard 등 법적 추적 가능 크레딧
model CarbonCreditRegistry {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")

  // 레지스트리 식별
  registry           String   @db.VarChar(50)        // K-ETS | Verra | GoldStandard | CDM
  projectId          String   @map("project_id") @db.VarChar(100)
  serialNumberStart  String   @map("serial_number_start") @db.VarChar(200)
  serialNumberEnd    String   @map("serial_number_end") @db.VarChar(200)
  vintageYear        Int      @map("vintage_year")
  creditType         String   @map("credit_type") @db.VarChar(20)     // KAU | KCU | OFFSET | VER | GS-VER
  certificationBody  String   @map("certification_body") @db.VarChar(100)
  issuanceDate       DateTime @map("issuance_date") @db.Date

  // 수량 추적 (총량 보존 법칙)
  totalQuantity      Decimal  @map("total_quantity")     @db.Decimal(20, 6)
  availableQuantity  Decimal  @map("available_quantity") @db.Decimal(20, 6)
  retiredQuantity    Decimal  @default(0) @map("retired_quantity") @db.Decimal(20, 6)
  lockedQuantity     Decimal  @default(0) @map("locked_quantity")  @db.Decimal(20, 6)  // 결제 진행 중 Lock

  // 낙관적 잠금 (동시성 제어)
  version            Int      @default(0)

  status             String   @default("active") @db.VarChar(20)   // active | retired | cancelled

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntries      CarbonLedgerEntry[]
  retirementCerts    CarbonRetirementCertificate[]
  vcmProject         CarbonVCMProject?
  tokenRecords       CarbonTokenRecord[]

  // 이중 계상 방지: 동일 레지스트리+프로젝트+일련번호+빈티지는 1건만
  @@unique([tenantId, registry, projectId, serialNumberStart, vintageYear])
  @@index([tenantId, creditType, vintageYear])
  @@index([tenantId, status])
  @@map("carbon_credit_registry")
}

/// 추가전용 거래 원장 (Event Sourcing)
/// 모든 BUY/SELL/RETIRE 이벤트의 불변 증거
model CarbonLedgerEntry {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  registryId     String   @map("registry_id")

  // 이벤트
  eventType      String   @map("event_type") @db.VarChar(20)   // BUY | SELL | RETIRE | LOCK | UNLOCK | CANCEL
  quantity       Decimal  @db.Decimal(20, 6)
  unitPrice      Decimal  @default(0) @map("unit_price")  @db.Decimal(15, 2)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(20, 2)
  currency       String   @default("KRW") @db.VarChar(3)

  // 거래 상대방
  counterparty   String?  @db.VarChar(200)

  // 결제 상태 라이프사이클
  paymentStatus    String  @default("N/A") @map("payment_status")    @db.VarChar(20)  // N/A|INITIATED|PENDING|SETTLED|FAILED
  settlementStatus String  @default("N/A") @map("settlement_status") @db.VarChar(20)  // N/A|PENDING|SETTLED|DISPUTED

  // 멱등성 키 (중복 제출 방지)
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(128)

  // 해시 체인 무결성
  hashSignature  String   @map("hash_signature") @db.VarChar(64)
  prevHash       String?  @map("prev_hash")       @db.VarChar(64)

  memo           String?  @db.Text
  metadata       Json?

  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registry       CarbonCreditRegistry         @relation(fields: [registryId], references: [id])
  payment        CarbonPayment?
  retirementCert CarbonRetirementCertificate?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, eventType])
  @@index([registryId])
  @@map("carbon_ledger_entry")
}

/// 소각(상계) 인증서 — 배출권 영구 소각 법적 증거
model CarbonRetirementCertificate {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  ledgerEntryId      String   @unique @map("ledger_entry_id")
  registryId         String   @map("registry_id")

  retirementId       String   @unique @map("retirement_id") @db.VarChar(50) // RET-YYYYMMDD-NNNNN
  serialNumbers      String   @map("serial_numbers") @db.Text               // 소각된 일련번호 목록 (JSON array)
  retiredQuantity    Decimal  @map("retired_quantity") @db.Decimal(20, 6)
  retirementReason   String   @map("retirement_reason") @db.Text
  beneficiaryCompany String   @map("beneficiary_company") @db.VarChar(200)
  retirementDate     DateTime @map("retirement_date") @db.Date
  registryReference  String?  @map("registry_reference") @db.VarChar(200)   // 외부 레지스트리 제출 번호
  certificatePdfUrl  String?  @map("certificate_pdf_url") @db.VarChar(500)

  // K-ETS 규정 준수
  offsetScope        String?  @map("offset_scope")        @db.VarChar(20)  // scope1 | scope2 | scope3
  compliancePeriod   String?  @map("compliance_period")   @db.VarChar(10)  // "2025"
  ketsSubmissionId   String?  @map("kets_submission_id")  @db.VarChar(100) // 환경부 제출 ID

  createdAt          DateTime @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntry        CarbonLedgerEntry      @relation(fields: [ledgerEntryId], references: [id])
  registry           CarbonCreditRegistry   @relation(fields: [registryId], references: [id])

  @@index([tenantId, retirementDate(sort: Desc)])
  @@index([tenantId, compliancePeriod])
  @@map("carbon_retirement_certificate")
}

/// 결제 라이프사이클 — 거래당 1:1 연결
model CarbonPayment {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  ledgerEntryId   String   @unique @map("ledger_entry_id")

  paymentMethod   String   @map("payment_method") @db.VarChar(20)             // bank_transfer | pg | escrow
  paymentStatus   String   @default("INITIATED") @map("payment_status") @db.VarChar(20)
  // INITIATED → PENDING → SETTLED | FAILED

  amount          Decimal  @db.Decimal(20, 2)
  currency        String   @default("KRW") @db.VarChar(3)

  // PG 결제
  pgProvider      String?  @map("pg_provider")       @db.VarChar(50)   // toss | inicis | kcp
  pgTransactionId String?  @map("pg_transaction_id") @db.VarChar(200)

  // 계좌 이체
  bankRefNumber   String?  @map("bank_ref_number") @db.VarChar(100)
  bankCode        String?  @map("bank_code")        @db.VarChar(10)
  accountLast4    String?  @map("account_last4")    @db.VarChar(4)

  // 에스크로
  escrowReleaseAt DateTime? @map("escrow_release_at")

  initiatedAt     DateTime  @default(now()) @map("initiated_at")
  settledAt       DateTime? @map("settled_at")
  failedAt        DateTime? @map("failed_at")
  failureReason   String?   @map("failure_reason") @db.Text

  metadata        Json?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntry     CarbonLedgerEntry  @relation(fields: [ledgerEntryId], references: [id])

  @@index([tenantId, paymentStatus])
  @@index([pgTransactionId])
  @@map("carbon_payment")
}

// ========================================
// COMPLIANCE: 테넌트 규제 설정
// ========================================

model TenantComplianceSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  // 지역/표준
  region            String  @default("KR") @db.VarChar(10)
  reportingStandard String  @default("GHG Protocol") @map("reporting_standard") @db.VarChar(100)

  // 배출계수 설정
  factorSource         String  @default("환경부") @map("factor_source") @db.VarChar(200)
  defaultEngineVersion String? @map("default_engine_version") @db.VarChar(20)
  electricityFactor    Decimal @default(0.4567) @map("electricity_factor") @db.Decimal(10, 6)

  // 기준 연도 / 감축 목표
  baseYear           Int      @default(2020) @map("base_year")
  targetReductionPct Decimal? @map("target_reduction_pct") @db.Decimal(5, 2)

  // 보고 주기
  reportingFrequency String @default("monthly") @map("reporting_frequency") @db.VarChar(20)
  fiscalYearStart    Int    @default(1) @map("fiscal_year_start") // 월(1~12)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_compliance_setting")
}

// ========================================
// COMPLIANCE: 불변 배출량 계산 레코드
// 원본 Overwrite 금지 — 재계산 시 isArchived=true 후 신규 생성
// ========================================

model EmissionsRecord {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  siteId   String? @map("site_id")

  // ⭐ 배출 기본
  scope                   String @db.VarChar(10)    // scope1, scope2_location, scope2_market, scope3
  sourceType              String @map("source_type") @db.VarChar(100)

  // ⭐ 활동 데이터
  activityData            Decimal @map("activity_data") @db.Decimal(15, 4)
  activityUnit            String  @map("activity_unit") @db.VarChar(50)
  activityDataSnapshot    Json?   @map("activity_data_snapshot")  // 원본 기록 스냅샷

  // ⭐ 계산 결과
  emissions Decimal @db.Decimal(15, 6)
  unit      String  @default("tCO2eq") @db.VarChar(20)

  // ⭐ 계산 기준 (감사 추적 핵심)
  engineVersionId         String  @map("engine_version_id")
  emissionFactorId        String  @map("emission_factor_id")
  emissionFactorVersion   String  @map("emission_factor_version") @db.VarChar(20)
  emissionFactorValue     Decimal @map("emission_factor_value") @db.Decimal(15, 8)
  calculationMethod       String  @map("calculation_method") @db.VarChar(50)  // location-based, market-based

  // ⭐ 데이터 품질
  dataSource              String  @map("data_source") @db.VarChar(50)  // sensor, manual, invoice
  dataQuality             String  @map("data_quality") @db.VarChar(20)  // good, uncertain

  // 기간
  period      String   @db.VarChar(7) // YYYY-MM
  recordedAt  DateTime @default(now()) @map("recorded_at")

  // ⭐ Append-only (재계산 시 기존 아카이브)
  isArchived       Boolean   @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  archivedBy       String?   @map("archived_by")
  archivedReason   String?   @map("archived_reason") @db.Text

  // 재계산 연결 (부모 → 자식 체인)
  parentId String? @map("parent_id")

  // ⭐ 계산 참여자 추적
  calculatedBy     String  @map("calculated_by")   // 누구(자동/Manual/AI)가 계산했는가
  dataSubmittedBy  String? @map("data_submitted_by") // 데이터 입력자

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engineVersion  CalcEngineVersion @relation(fields: [engineVersionId], references: [id])
  emissionFactor EmissionFactor    @relation(fields: [emissionFactorId], references: [id])

  @@index([tenantId, period])
  @@index([scope])
  @@index([isArchived])
  @@index([engineVersionId])
  @@map("emissions_record")
}

// ========================================
// ESG: Big4 감사 대응 ESG 보고서 (Immutable + Hash-chain)
// ========================================

model ESGReport {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // ⭐ 보고서 식별 (채번: ESG-YYYYMMDD-NNNN)
  reportNo   String        @unique @map("report_no") @db.VarChar(30)
  reportType ESGReportType @map("report_type") // compliance, sustainability, annual
  standard   String        @db.VarChar(50)     // GHG_PROTOCOL, K_MRV, CDP, ISSB

  // 다국가 지원
  countryCode String @default("KR") @map("country_code") @db.VarChar(5)

  // 보고 기간
  period     String @db.VarChar(10) // YYYY or YYYY-MM
  periodType String @map("period_type") @db.VarChar(10) // annual, monthly, quarterly
  reportYear Int    @map("report_year")

  // ⭐ 배출량 요약 (tCO2eq)
  totalEmissions Decimal  @map("total_emissions") @db.Decimal(15, 6)
  scope1         Decimal  @db.Decimal(15, 6)
  scope2Location Decimal  @map("scope2_location") @db.Decimal(15, 6)
  scope2Market   Decimal? @map("scope2_market") @db.Decimal(15, 6) // Market-based (선택)
  scope3         Decimal  @db.Decimal(15, 6)
  emissionsUnit  String   @default("tCO2eq") @map("emissions_unit") @db.VarChar(20)

  // ⭐ 스냅샷 (감사 추적 핵심: 보고서 생성 시점 불변 기록)
  emissionFactorsSnapshot   Json  @map("emission_factors_snapshot")    // 사용된 배출계수 목록 + 버전
  engineVersionSnapshot     Json  @map("engine_version_snapshot")      // 계산엔진 정보
  calculationMethodSnapshot Json  @map("calculation_method_snapshot")  // 계산방식 (location/market)
  boundarySnapshot          Json  @map("boundary_snapshot")            // 조직경계, 운영경계 설정
  activityDataSnapshot      Json? @map("activity_data_snapshot")       // 원본 활동 데이터 집계

  // 규제 준수
  applicableStandards String   @map("applicable_standards") @db.VarChar(500) // GHG Protocol, ISO 14064, K-ETS
  methodologyNotes    String?  @map("methodology_notes") @db.Text
  completenessScore   Decimal? @map("completeness_score") @db.Decimal(5, 2) // 데이터 완전성 0-100%

  // ⭐ 무결성 (Tamper resistance)
  dataHash    String  @map("data_hash") @db.VarChar(64) // SHA-256 of immutable content
  isImmutable Boolean @default(false) @map("is_immutable") // 승인 후 true → 수정 불가

  // XBRL 확장 (ISSB/IFRS S2 대응)
  xbrlTaxonomy  String? @map("xbrl_taxonomy") @db.VarChar(100) // ifrs-full, ghg-protocol
  xbrlExportUrl String? @map("xbrl_export_url") @db.VarChar(500)

  // 생성 파일 (PDF, Excel)
  pdfUrl   String? @map("pdf_url") @db.VarChar(500)
  excelUrl String? @map("excel_url") @db.VarChar(500)

  // ⭐ 상태 및 승인 워크플로우
  status ESGReportStatus @default(draft)

  generatedBy String    @map("generated_by")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")

  // 버전 재발행 추적
  previousReportId String? @map("previous_report_id") // 재발행 시 이전 보고서 참조
  revisionNumber   Int     @default(1) @map("revision_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  previousReport ESGReport? @relation("ESGReportRevisions", fields: [previousReportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions      ESGReport[] @relation("ESGReportRevisions")

  @@index([tenantId, reportYear])
  @@index([standard, countryCode])
  @@index([status])
  @@index([isImmutable])
  @@map("esg_report")
}

enum ESGReportType {
  compliance    // 규제 의무 제출 (K-ETS, 환경부 K-MRV)
  sustainability // 자발적 공시 (CDP, ISSB/IFRS S2)
  annual        // 연간 통합 보고서
  interim       // 중간 (반기/분기) 보고서
}

enum ESGReportStatus {
  draft       // 초안 (수정 가능)
  in_review   // 검토 중
  approved    // 승인 완료 (isImmutable=true)
  published   // 공개 발표
  withdrawn   // 철회
}

// ========================================
// ESG REPORT AUDIT: 리포트 감사 추적 테이블
// ========================================

/// 리포트 생성 시도 감사 로그 (성공/실패 모두 기록)
model ReportGenerationLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  reportId     String?  @map("report_id")      // 성공 시에만 연결
  standard     String   @db.VarChar(50)
  period       String   @db.VarChar(10)
  status       String   @db.VarChar(20)         // pending|success|failed
  durationMs   Int?     @map("duration_ms")
  errorMessage String?  @map("error_message") @db.Text
  triggeredBy  String   @map("triggered_by")
  inputHash    String?  @map("input_hash") @db.VarChar(64)  // SHA-256 of input (재현성)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([reportId])
  @@map("report_generation_log")
}

/// 리포트 상태 변경 감사 로그 (Append-only)
model ReportAuditLog {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  tenantId    String   @map("tenant_id")
  action      String   @db.VarChar(50)          // generate|submit_review|approve|publish|withdraw|reissue
  fromStatus  String?  @map("from_status") @db.VarChar(30)
  toStatus    String?  @map("to_status") @db.VarChar(30)
  performedBy String   @map("performed_by")
  note        String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reportId, createdAt])
  @@index([tenantId, action])
  @@map("report_audit_log")
}

/// 리포트에 사용된 원본 데이터 출처 추적 (데이터 계보/Lineage)
model ReportDataSource {
  id           String   @id @default(uuid())
  reportId     String   @map("report_id")
  tenantId     String   @map("tenant_id")
  sourceType   String   @map("source_type") @db.VarChar(50) // emissions_record|manual_input|invoice|meter_reading
  sourceId     String   @map("source_id")                   // 원본 레코드 ID
  scope        String   @db.VarChar(30)                     // scope1|scope2_location|scope2_market|scope3
  period       String   @db.VarChar(10)
  activityData Decimal  @map("activity_data") @db.Decimal(20, 6)
  activityUnit String   @map("activity_unit") @db.VarChar(20)
  emissions    Decimal  @db.Decimal(20, 6)
  dataQuality  String   @map("data_quality") @db.VarChar(20) // sensor|manual|estimated
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@index([tenantId, period])
  @@map("report_data_source")
}

// ========================================
// DOWNLOAD: 다운로드 이력 관리
// ========================================

model DownloadHistory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  userId   String? @map("user_id")

  // 다운로드 정보
  category  String @db.VarChar(50)  // energy, sensor, device, alert, cost, carbon
  format    String @db.VarChar(10)  // csv, json
  filename  String @db.VarChar(255)

  // 기간
  startDate String @map("start_date") @db.VarChar(10) // YYYY-MM-DD
  endDate   String @map("end_date") @db.VarChar(10)   // YYYY-MM-DD

  // 결과
  rowCount  Int    @default(0) @map("row_count")
  sizeBytes Int    @default(0) @map("size_bytes")
  status    String @default("completed") @db.VarChar(20) // completed, failed

  // 파일 경로 (세션에서 생성한 파일은 저장되지 않음 — null)
  filepath  String? @db.VarChar(500) // 저장된 파일의 절대 경로, null이면 이전 세션 또는 메모리 파일

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([category])
  @@map("download_history")
}

// ========================================
// CARBON: 탄소중립 로드맵 마일스톤
// ========================================

model Milestone {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")

  year         Int
  title        String @db.VarChar(500)
  // achieved | in_progress | pending
  status       String @default("pending") @db.VarChar(20)
  displayOrder Int    @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, year])
  @@index([tenantId, displayOrder])
  @@map("milestone")
}

// ========================================
// ACTIVITY LOG: 메뉴별 사용자 활동 이력
// ========================================

model ActivityLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // 채번: 메뉴코드 단축 2자 + YYYYMMDD + 일별 4자리 순번 (예: ST-20260301-0001)
  logNo String @unique @map("log_no") @db.VarChar(30)

  // 메뉴/화면 코드 (예: SITE_MGMT, DEVICE_MGMT, CARBON_FUEL, DR_EVENT, REPORT_GEN)
  menuCode  String @map("menu_code") @db.VarChar(50)
  // 액션 유형 (예: CREATE, UPDATE, DELETE, DOWNLOAD, UPLOAD, GENERATE)
  actionType  String @map("action_type") @db.VarChar(50)
  // 화면 표시용 한글 레이블 (예: "연료 등록", "사이트 생성", "보고서 생성")
  actionLabel String @map("action_label") @db.VarChar(100)

  // 대상 리소스
  resourceType String? @map("resource_type") @db.VarChar(50) // site, device, sensor, fuel, transport, dr_event, report
  resourceId   String? @map("resource_id") @db.VarChar(255)
  resourceName String? @map("resource_name") @db.VarChar(500)

  // 변경 데이터 (JSON)
  beforeData Json? @map("before_data") // 변경 전 (UPDATE/DELETE)
  afterData  Json? @map("after_data")  // 변경 후 (CREATE/UPDATE)
  metadata   Json? // 추가 메타 (파일명, 행수, 기간 등)

  // 처리 결과
  status       String  @default("success") @db.VarChar(20) // success, failed
  errorMessage String? @map("error_message") @db.Text

  // 요청자 정보
  userId    String? @map("user_id") @db.VarChar(255)
  userName  String? @map("user_name") @db.VarChar(200)
  userEmail String? @map("user_email") @db.VarChar(200)
  userRole  String? @map("user_role") @db.VarChar(50)
  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, menuCode, createdAt(sort: Desc)])
  @@index([tenantId, actionType])
  @@index([tenantId, userId])
  @@map("activity_log")
}

// ========================================
// ACTIVITY LOG SEQ: 채번 카운터 테이블
// 메뉴코드 단축 PREFIX + 날짜별 일련번호 관리
// ========================================

model ActivityLogSeq {
  // 메뉴코드 단축 코드 (예: ST, DV, CF, DR)
  prefix  String @db.VarChar(10)
  // 날짜 (YYYYMMDD 형식)
  seqDate String @map("seq_date") @db.Char(8)
  // 해당 날짜/prefix의 현재 최대 순번 (1부터 시작, 매일 리셋)
  seq     Int    @default(1)

  @@id([prefix, seqDate])
  @@map("activity_log_seq")
}

// ========================================
// CARBON EXTENSIONS: VCM / 블록체인 / 지갑
// ========================================

/// 자발적 탄소 시장(VCM) 프로젝트 메타데이터
/// CarbonCreditRegistry 1:1 확장 — Verra/GoldStandard 크레딧 전용
model CarbonVCMProject {
  id                    String   @id @default(uuid())
  registryId            String   @unique @map("registry_id")

  // 프로젝트 분류
  projectCategory       String   @map("project_category") @db.VarChar(50)
  // 레지스트리 프로젝트 ID
  verraProjectId        String?  @map("verra_project_id") @db.VarChar(50)
  goldStandardId        String?  @map("gold_standard_id") @db.VarChar(50)
  // 지리 정보
  countryCode           String   @map("country_code") @db.VarChar(3)
  // 프로젝트 기간
  projectStartDate      DateTime @map("project_start_date") @db.Date
  monitoringPeriodStart DateTime @map("monitoring_period_start") @db.Date
  monitoringPeriodEnd   DateTime @map("monitoring_period_end") @db.Date
  // 품질 등급
  addionalityRating     String   @default("unrated") @map("addiionality_rating") @db.VarChar(10)
  permanenceRisk        String   @default("medium") @map("permanence_risk") @db.VarChar(10)
  // 공동편익 (JSON — SDG 배열 포함)
  sdgGoals              Json     @default("[]") @map("sdg_goals")
  biodiversityImpact    Boolean  @default(false) @map("biodiversity_impact")
  communityBenefit      Boolean  @default(false) @map("community_benefit")
  waterConservation     Boolean  @default(false) @map("water_conservation")
  livelihoodImprovement Boolean  @default(false) @map("livelihood_improvement")
  coBenefitDescription  String?  @map("co_benefit_description") @db.Text
  // 검증 기관
  thirdPartyVerifier    String?  @map("third_party_verifier") @db.VarChar(100)
  verificationReportUrl String?  @map("verification_report_url") @db.VarChar(500)
  baselineMethodology   String?  @map("baseline_methodology") @db.VarChar(100)
  expectedAnnualReductions Decimal? @map("expected_annual_reductions") @db.Decimal(15, 2)

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  registry CarbonCreditRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  @@index([projectCategory])
  @@index([countryCode])
  @@map("carbon_vcm_project")
}

/// 블록체인 토큰화 탄소 크레딧 레코드
/// CarbonCreditRegistry 기반 — Toucan/KlimaDAO/C3 등 온체인 토큰과 연결
model CarbonTokenRecord {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  registryId          String    @map("registry_id")

  // 지갑/토큰 정보
  walletAddress       String    @map("wallet_address") @db.VarChar(100)
  tokenStandard       String    @map("token_standard") @db.VarChar(20)    // ERC-20|ERC-1155|ERC-721|SPL
  network             String    @db.VarChar(30)                            // ethereum|polygon|celo|solana
  protocol            String    @default("custom") @db.VarChar(20)        // toucan|klimadao|c3|moss|regen|custom
  contractAddress     String    @map("contract_address") @db.VarChar(100)
  tokenId             String?   @map("token_id") @db.VarChar(100)         // ERC-1155/721

  // 수량
  tokenizedQuantity   Decimal   @map("tokenized_quantity") @db.Decimal(20, 6)

  // 온체인 상태
  onChainStatus       String    @map("on_chain_status") @db.VarChar(30)   // pending|confirmed|bridging|retired_on_chain|failed|syncing
  txHash              String?   @map("tx_hash") @db.VarChar(100)
  blockNumber         BigInt?   @map("block_number")

  // 시간 추적
  bridgedAt           DateTime? @map("bridged_at")
  retiredOnChainAt    DateTime? @map("retired_on_chain_at")

  metadata            Json?

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registry CarbonCreditRegistry @relation(fields: [registryId], references: [id])

  @@index([tenantId, onChainStatus])
  @@index([registryId])
  @@index([walletAddress])
  @@index([tenantId, network])
  @@map("carbon_token_record")
}

/// 테넌트 탄소 지갑 — 블록체인 주소 1:1 관리
/// 멀티테넌트: 테넌트당 1개 지갑 주소 (네트워크별 확장 가능)
model TenantCarbonWallet {
  id            String    @id @default(uuid())
  tenantId      String    @unique @map("tenant_id")
  network       String    @db.VarChar(30)             // ethereum|polygon|celo|solana
  walletAddress String    @map("wallet_address") @db.VarChar(100)
  isVerified    Boolean   @default(false) @map("is_verified")
  verifiedAt    DateTime? @map("verified_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([network])
  @@map("tenant_carbon_wallet")
}

// ========================================
// RBAC: Feature — 기능 단위 정의
// ========================================
// Feature는 메뉴·API 접근의 최소 권한 단위.
// Plan.features(JSON)을 이 테이블로 정규화하여 DB 기반 제어.

model Feature {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(100)   // e.g. "carbon_trading", "ai_forecast"
  name        String  @db.VarChar(200)
  description String? @db.Text
  category    String  @db.VarChar(50)             // analytics|ai|control|report|admin
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  planFeatures PlanFeature[]

  @@index([category, isActive])
  @@map("feature")
}

// ========================================
// RBAC: PlanFeature — Plan × Feature 매핑
// ========================================
// 플랜별 허용 기능 정의. Plan.features JSON을 대체·보완.
// 이 테이블 기준으로 메뉴/API 접근 제어.

model PlanFeature {
  id        String @id @default(uuid())
  planId    String @map("plan_id")
  featureCode String @map("feature_code") @db.VarChar(100)

  // 제한값 (선택적 — 기능별 할당량)
  limitValue Int? @map("limit_value")            // e.g. max AI queries/month
  limitUnit  String? @map("limit_unit") @db.VarChar(30)  // e.g. "monthly"

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureCode], references: [code], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@index([planId])
  @@index([featureCode])
  @@map("plan_feature")
}

// ========================================
// SUPER ADMIN: 설비 제품 카탈로그
// ========================================

model EquipmentProduct {
  id           String          @id @default(uuid())

  // 기본 정보
  name         String          @db.VarChar(200)
  modelNumber  String          @unique @map("model_number") @db.VarChar(100)
  manufacturer String          @db.VarChar(100)
  category     ProductCategory

  // 적용 시설 유형 (JSON array: ["building","factory","residential"])
  facilityTypes Json           @map("facility_types")

  // 기술 스펙 (JSON: voltage, current, power, protocol 등)
  specs        Json

  // 호환 프로토콜 (JSON array: ["modbus_tcp","bacnet","mqtt"])
  protocols    Json

  // 가격
  unitPrice    Decimal?        @map("unit_price") @db.Decimal(12, 2)

  // 설명
  description  String?         @db.Text
  imageUrl     String?         @map("image_url") @db.VarChar(500)

  // 설치 난이도: easy | medium | hard
  installDifficulty String    @default("medium") @map("install_difficulty") @db.VarChar(20)

  // 보증 기간 (개월)
  warrantyMonths Int           @default(12) @map("warranty_months")

  // 활성 여부
  isActive     Boolean         @default(true) @map("is_active")

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  lotItems     EquipmentLotItem[]
  stockRecords EquipmentStock[]

  @@index([category])
  @@index([isActive])
  @@map("equipment_product")
}

enum ProductCategory {
  gateway
  sensor
  controller
  meter
  display
  accessory
}

// ========================================
// SUPER ADMIN: 납품 로트 (도입기업별)
// ========================================

model EquipmentLot {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")

  // 로트 번호 (예: LOT-20260307-0001)
  lotNumber    String     @unique @map("lot_number") @db.VarChar(100)

  // 시설 유형: building | factory | residential
  facilityType String     @map("facility_type") @db.VarChar(50)

  // 상태
  status       LotStatus  @default(pending)

  // 납품 일정
  orderedAt    DateTime?  @map("ordered_at") @db.Date
  shippedAt    DateTime?  @map("shipped_at") @db.Date
  deliveredAt  DateTime?  @map("delivered_at") @db.Date
  installedAt  DateTime?  @map("installed_at") @db.Date

  // 설치 담당자
  technicianName  String? @map("technician_name") @db.VarChar(100)
  technicianPhone String? @map("technician_phone") @db.VarChar(50)

  // 연결 사이트 (선택 — 테넌트 내 등록된 사이트 참조)
  siteId          String? @map("site_id") @db.VarChar(36)

  // 설치 사이트 정보 (스냅샷 — 삭제/변경 방지)
  siteAddress     String? @map("site_address") @db.Text
  siteContact     String? @map("site_contact") @db.VarChar(100)

  // 비고
  notes        String?    @db.Text

  // 메타
  metadata     Json?

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        EquipmentLotItem[]

  @@index([tenantId])
  @@index([siteId])
  @@index([status])
  @@index([facilityType])
  @@index([deliveredAt])
  @@map("equipment_lot")
}

enum LotStatus {
  pending     // 발주
  shipped     // 출하
  delivered   // 납품 완료
  installing  // 설치 중
  installed   // 설치 완료
  active      // 운영 중
  returned    // 반납
}

// ========================================
// SUPER ADMIN: 로트 품목 (설비 단위)
// ========================================

model EquipmentLotItem {
  id           String       @id @default(uuid())
  lotId        String       @map("lot_id")
  productId    String       @map("product_id")

  // 수량
  quantity     Int          @default(1)

  // 시리얼 번호 (JSON array)
  serialNumbers Json        @map("serial_numbers")

  // 품목 상태
  status       LotItemStatus @default(pending)

  // 연결된 기기/게이트웨이 ID (설치 후 매핑)
  deviceId     String?      @map("device_id") @db.VarChar(36)
  gatewayId    String?      @map("gateway_id") @db.VarChar(36)

  // 불량 사유 (반납/불량 시)
  defectNote   String?      @map("defect_note") @db.Text

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  lot          EquipmentLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  product      EquipmentProduct @relation(fields: [productId], references: [id])

  @@index([lotId])
  @@index([productId])
  @@map("equipment_lot_item")
}

enum LotItemStatus {
  pending
  installed
  active
  faulty
  returned
}

// ────────────────────────────────────────────────────────────────
// 창고 입고 이력 (equipment_stock)
// ────────────────────────────────────────────────────────────────

model EquipmentStock {
  id          String           @id @default(uuid())
  productId   String           @map("product_id") @db.VarChar(36)
  quantity    Int              @default(1)
  receivedAt  DateTime         @map("received_at")
  supplier    String?          @db.VarChar(200)
  unitCost    Decimal?         @map("unit_cost") @db.Decimal(15, 2)
  batchNo     String?          @map("batch_no") @db.VarChar(100)
  notes       String?          @db.Text
  createdBy   String?          @map("created_by") @db.VarChar(36)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  product     EquipmentProduct @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("equipment_stock")
}

// ────────────────────────────────────────────────────────────────
// 규제 샌드박스 신청 (regulatory_sandbox)
// ────────────────────────────────────────────────────────────────

model RegulatorySandbox {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id") @db.VarChar(36)
  title            String    @db.VarChar(300)
  description      String?   @db.Text
  regulationType   String    @map("regulation_type") @db.VarChar(50)
  exemptionScope   String?   @map("exemption_scope") @db.Text
  status           String    @default("pending") @db.VarChar(20)
  appliedAt        DateTime  @map("applied_at")
  reviewStartedAt  DateTime? @map("review_started_at")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedBy       String?   @map("reviewed_by") @db.VarChar(36)
  expireDate       DateTime? @map("expire_date") @db.Date
  reviewNote       String?   @map("review_note") @db.Text
  conditions       Json?
  applicantName    String?   @map("applicant_name") @db.VarChar(100)
  applicantEmail   String?   @map("applicant_email") @db.VarChar(200)
  contactPhone     String?   @map("contact_phone") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([status, appliedAt])
  @@map("regulatory_sandbox")
}

// ────────────────────────────────────────────────────────────────
// 탄소 시장 가격 이력 (carbon_market_price)
// - K-ETS / EU-ETS / VCM 등 시장별 가격 히스토리
// - 위험 시뮬레이션, 가격 분석, 포트폴리오 평가에 활용
// - env KETS_MARKET_PRICE 대체 (DB 기반 가격 관리)
// ────────────────────────────────────────────────────────────────

model CarbonMarketPrice {
  id         String   @id @default(uuid())
  market     String   @db.VarChar(20)   // KETS | EU_ETS | VCM | GOLD_STANDARD
  priceDate  DateTime @map("price_date") @db.Date
  price      Decimal  @db.Decimal(15, 4)
  currency   String   @default("KRW") @db.VarChar(10)
  unit       String   @default("tCO2") @db.VarChar(20)
  source     String?  @db.VarChar(200)  // KAU | KCU | CBL | 수기입력 등
  changeRate Decimal? @map("change_rate") @db.Decimal(10, 4)  // 전일 대비 등락률(%)
  volume     Int?                                              // 거래량 (선택)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([market, priceDate], name: "uq_market_date")
  @@index([market, priceDate(sort: Desc)])
  @@map("carbon_market_price")
}

// ========================================
// SECURITY: Ransomware Alert
// ========================================

model RansomwareAlert {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  userId      String?   @map("user_id")
  sourceIp    String?   @map("source_ip") @db.VarChar(45)
  alertType   String    @map("alert_type") @db.VarChar(50)
  severity    String    @db.VarChar(20)
  description String    @db.Text
  metadata    Json?
  status      String    @default("open") @db.VarChar(30)
  resolvedBy  String?   @map("resolved_by")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId, status, createdAt])
  @@index([alertType, severity])
  @@map("ransomware_alert")
}

// ========================================
// SECURITY: Backup Record
// ========================================

model BackupRecord {
  id           String    @id @default(uuid())
  backupType   String    @map("backup_type") @db.VarChar(20)
  status       String    @db.VarChar(20)
  sizeBytes    BigInt?   @map("size_bytes")
  storagePath  String    @map("storage_path") @db.VarChar(500)
  checksum     String?   @db.VarChar(64)
  isImmutable  Boolean   @default(true) @map("is_immutable")
  expiresAt    DateTime? @map("expires_at")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  metadata     Json?

  @@index([backupType, status])
  @@map("backup_record")
}

// ========================================
// ERP: Invoice
// ========================================

model Invoice {
  id             String    @id @default(uuid())
  invoiceNo      String    @unique @map("invoice_no") @db.VarChar(30)
  tenantId       String    @map("tenant_id")
  subscriptionId String?   @map("subscription_id")
  periodStart    String    @map("period_start") @db.VarChar(10)
  periodEnd      String    @map("period_end") @db.VarChar(10)
  subtotal       Decimal   @db.Decimal(12, 2)
  taxRate        Decimal   @default(0.1000) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount      Decimal   @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  currency       String    @default("KRW") @db.VarChar(3)
  status         String    @default("draft") @db.VarChar(20)
  dueDate        DateTime  @map("due_date")
  paidAt         DateTime? @map("paid_at")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  lineItems InvoiceLineItem[]

  @@index([tenantId, status])
  @@index([periodStart, status])
  @@map("invoice")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String   @db.VarChar(500)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_item")
}

// ========================================
// ERP: KPI Snapshot (에너지 + 재무 KPI 월별 스냅샷)
// ========================================

model KpiSnapshot {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  period         String   @db.VarChar(7)
  totalKwh       Decimal  @map("total_kwh") @db.Decimal(15, 3)
  peakKw         Decimal  @map("peak_kw") @db.Decimal(10, 3)
  baselineKwh    Decimal? @map("baseline_kwh") @db.Decimal(15, 3)
  savedKwh       Decimal? @map("saved_kwh") @db.Decimal(15, 3)
  totalCo2Kg     Decimal  @map("total_co2_kg") @db.Decimal(15, 3)
  savedCo2Kg     Decimal? @map("saved_co2_kg") @db.Decimal(15, 3)
  energyCostKrw  Decimal? @map("energy_cost_krw") @db.Decimal(15, 2)
  savedCostKrw   Decimal? @map("saved_cost_krw") @db.Decimal(15, 2)
  investmentKrw  Decimal? @map("investment_krw") @db.Decimal(15, 2)
  roiPercent     Decimal? @map("roi_percent") @db.Decimal(8, 2)
  paybackMonths  Decimal? @map("payback_months") @db.Decimal(6, 1)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, period], name: "kpi_snapshot_tenant_id_period_key")
  @@index([period])
  @@map("kpi_snapshot")
}

// ========================================
// RETENTION: Churn Score (일별 이탈 예측 점수)
// 0점 = 완전히 건강, 100점 = 즉시 이탈 위험
// ========================================

model TenantChurnScore {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  period   String @db.VarChar(10) // YYYY-MM-DD

  // 총점 (0~100, 높을수록 이탈 위험)
  churnScore Int    @default(0) @map("churn_score")
  riskLevel  String @default("normal") @map("risk_level") @db.VarChar(20) // normal|warning|critical

  // 세부 점수 요소 (각 항목 0~100 환산 후 가중치 적용)
  onboardingScore   Int @default(0) @map("onboarding_score")   // 가중치 20%
  engagementScore   Int @default(0) @map("engagement_score")   // 가중치 25%
  organizationScore Int @default(0) @map("organization_score") // 가중치 15%
  roiScore          Int @default(0) @map("roi_score")          // 가중치 20%
  supportScore      Int @default(0) @map("support_score")      // 가중치 10%
  paymentScore      Int @default(0) @map("payment_score")      // 가중치 10%

  // 점수 계산 근거 (JSON: {reasons: string[], signals: object})
  scoreReasons Json? @map("score_reasons")

  // 리텐션 액션 연동
  actionTaken   Boolean   @default(false) @map("action_taken")
  actionTakenAt DateTime? @map("action_taken_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, period])
  @@index([churnScore(sort: Desc), createdAt(sort: Desc)])
  @@index([riskLevel, createdAt(sort: Desc)])
  @@map("tenant_churn_score")
}

// ========================================
// RETENTION: 행동 이벤트 트래킹
// ========================================

model RetentionEvent {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  userId   String? @map("user_id")

  // 이벤트 유형
  // login | device_connected | iot_data_received | ai_analysis_run
  // report_generated | alert_triggered | alert_clicked
  // feature_used | payment_succeeded | payment_failed
  // support_ticket_opened | support_ticket_resolved | plan_changed
  eventType  String @map("event_type") @db.VarChar(80)
  properties Json? // 이벤트별 추가 데이터 (deviceId, featureName 등)

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([tenantId, eventType, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("retention_event")
}

// ========================================
// RETENTION: 온보딩 마일스톤 (TTFV 추적)
// ========================================

model OnboardingMilestone {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  // 마일스톤 달성 시각 (null = 미완료)
  iotConnectedAt    DateTime? @map("iot_connected_at")
  firstDataAt       DateTime? @map("first_data_at")
  firstAiAnalysisAt DateTime? @map("first_ai_analysis_at")
  firstReportAt     DateTime? @map("first_report_at")
  firstAlertAt      DateTime? @map("first_alert_at")

  // Time To First Value (초, IoT 최초 연결 → 첫 데이터 수집까지)
  ttfvSeconds Int? @map("ttfv_seconds")

  // 완료율 (0~100)
  completionPct Int @default(0) @map("completion_pct")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("onboarding_milestone")
}

// ========================================
// RETENTION: 자동 리텐션 액션 이력
// ========================================

model RetentionAction {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // 트리거 조건
  trigger    String @map("trigger_type") @db.VarChar(80) // churn_critical | no_login_7d | onboarding_stuck | payment_failed_3 | roi_negative
  churnScore Int    @default(0) @map("churn_score") // 발송 시점 점수

  // 발송 채널
  channel    String @db.VarChar(30) // email | sms | kakao | slack
  templateId String @map("template_id") @db.VarChar(80)

  // 수신 정보
  recipientId    String? @map("recipient_id")    // userId
  recipientPhone String? @map("recipient_phone") @db.VarChar(20)
  recipientEmail String? @map("recipient_email") @db.VarChar(200)

  // 발송 결과
  status    String    @default("sent") @db.VarChar(20) // sent|delivered|read|failed
  sentAt    DateTime  @default(now()) @map("sent_at")
  readAt    DateTime? @map("read_at")

  // 응답 전환 여부
  responded   Boolean   @default(false)
  respondedAt DateTime? @map("responded_at")

  metadata Json?

  @@index([tenantId, sentAt(sort: Desc)])
  @@index([trigger, sentAt(sort: Desc)])
  @@index([status])
  @@map("retention_action")
}

// ========================================
// KAKAO: 알림톡 발송 이력 (Solapi 연동)
// ========================================

model KakaoAlimtalkLog {
  id         String  @id @default(uuid())
  tenantId   String? @map("tenant_id")
  userId     String? @map("user_id")
  phone      String  @db.VarChar(20)
  templateId String  @map("template_id") @db.VarChar(80)
  variables  Json? // 템플릿 변수

  // Solapi 발송 결과
  status     String  @default("pending") @db.VarChar(20) // pending|sent|delivered|failed
  msgKey     String? @map("msg_key") @db.VarChar(100) // Solapi 메시지 키
  failReason String? @map("fail_reason") @db.Text

  sentAt DateTime @default(now()) @map("sent_at")

  @@index([tenantId, sentAt(sort: Desc)])
  @@index([status, sentAt(sort: Desc)])
  @@map("kakao_alimtalk_log")
}
