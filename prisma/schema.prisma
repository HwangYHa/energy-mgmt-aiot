// ========================================
// COMPLIANCE: 배출계수 관리
// ========================================

model EmissionFactor {
  id       String @id @default(uuid())
  tenantId String? @map("tenant_id") // null = 글로벌 기본값

  // ── 기존 식별 (하위 호환 유지) ──────────────────────────────
  name       String? @db.VarChar(200)
  code       String  @db.VarChar(50)
  category   String  @db.VarChar(50)
  sourceType String  @map("source_type") @db.VarChar(100)

  // ── v2: 표준화 식별자 (Big4 감사 대응) ─────────────────────
  // factorCode: "kr-electricity-grid-location" 형태 표준 식별자
  // code보다 구체적, 국가+에너지타입+계산방식 인코딩
  factorCode      String? @map("factor_code") @db.VarChar(100)
  countryCode     String? @map("country_code") @db.Char(2)   // ISO 3166-1: KR, US, EU
  energyType      String? @map("energy_type") @db.VarChar(50) // electricity|diesel|lng|coal...
  calculationType String? @map("calculation_type") @db.VarChar(20) // location|market|activity|spend

  // ── 계수 값 ─────────────────────────────────────────────────
  factor     Decimal @db.Decimal(20, 10) // v2: 정밀도 향상 (10자리)
  unit       String  @db.VarChar(50)
  inputUnit  String  @map("input_unit") @db.VarChar(50)

  // ── 출처 추적 ────────────────────────────────────────────────
  source        String  @db.VarChar(200) // 기관명 (하위호환)
  sourceName    String? @map("source_name") @db.VarChar(200)    // v2: "국가 온실가스 인벤토리"
  sourceVersion String? @map("source_version") @db.VarChar(50)  // v2: "2024년판", "AR6"
  sourceUrl     String? @map("source_url") @db.VarChar(500)     // v2: 공식 문서 URL
  // sourceType (enum): official|international|tenant_custom
  factorSourceType String? @map("factor_source_type") @db.VarChar(30) // official|international|tenant_custom
  year      Int
  region    String  @default("KR") @db.VarChar(10)

  // ── Semantic Versioning ──────────────────────────────────────
  version    String  @db.VarChar(20)
  parentId   String? @map("parent_id")

  // ── 상태 제어 ────────────────────────────────────────────────
  isCustom   Boolean @default(false) @map("is_custom")
  isDefault  Boolean @default(false) @map("is_default")
  isActive   Boolean @default(false) @map("is_active") // v2: default false → 승인 후 활성

  // ── v2: 승인 상태 머신 ──────────────────────────────────────
  // DRAFT → PENDING_REVIEW → APPROVED | REJECTED
  approvalStatus String @default("APPROVED") @map("approval_status") @db.VarChar(30)

  // ── 유효기간 ─────────────────────────────────────────────────
  validFrom  DateTime @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date

  // ── 승인 / 거부 워크플로우 ───────────────────────────────────
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  rejectedBy     String?   @map("rejected_by")
  rejectedAt     DateTime? @map("rejected_at")
  rejectionReason String?  @map("rejection_reason") @db.Text
  changeReason    String?  @map("change_reason") @db.Text

  // ── v2: 레코드 무결성 ───────────────────────────────────────
  // SHA-256(핵심 필드 JSON) — 감사 시 재계산으로 레코드 변조 탐지
  recordHash String? @map("record_hash") @db.VarChar(64)

  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  tenant             Tenant?  @relation(fields: [tenantId], references: [id])
  parent             EmissionFactor? @relation("EmissionFactorVersions", fields: [parentId], references: [id])
  children           EmissionFactor[] @relation("EmissionFactorVersions")
  emissionsRecords   EmissionsRecord[]
  auditLog           EmissionFactorAuditLog[]

  // ── 제약 ─────────────────────────────────────────────────────
  @@unique([code, version])

  // ── 인덱스 전략 (조회 패턴 최적화) ──────────────────────────
  @@index([tenantId, factorCode, isActive])                      // 3-tier lookup 핵심
  @@index([tenantId, countryCode, energyType, calculationType])  // 복합 조건 조회
  @@index([category])
  @@index([tenantId])
  @@index([year, region])
  @@index([validFrom, validTo])
  @@index([approvalStatus])
  @@index([factorCode, validFrom(sort: Desc)])                   // 버전 체인 조회
  @@map("emission_factor")
}

// ========================================
// COMPLIANCE: 배출계수 감사 로그 (Append-only, Hash-chain)
// ========================================

model EmissionFactorAuditLog {
  id                  String @id @default(uuid())
  emissionFactorId    String @map("emission_factor_id")

  // ── 변경 내용 ─────────────────────────────────────────────────
  changeType     String   @map("change_type") @db.VarChar(30)
  // CREATED|SUBMITTED_FOR_REVIEW|APPROVED|REJECTED|DEPRECATED|RESTORED

  // 수치 변경 별도 트래킹 (조회 최적화, 기존 oldValue/newValue 유지)
  oldValue       Decimal? @db.Decimal(20, 10) @map("old_value")
  newValue       Decimal? @db.Decimal(20, 10) @map("new_value")
  changeReason   String?  @db.Text @map("change_reason")

  // ── v2: 전체 스냅샷 (Big4 감사: 변경 전/후 완전 재현) ────────
  previousSnapshot Json? @map("previous_snapshot")
  currentSnapshot  Json? @map("current_snapshot")

  // ── Hash Chain ─────────────────────────────────────────────────
  previousHash   String? @map("previous_hash") @db.VarChar(64)
  currentHash    String  @map("current_hash") @db.VarChar(64)

  // ── 요청자 정보 ───────────────────────────────────────────────
  requestedBy String   @map("requested_by")
  requestedAt DateTime @default(now()) @map("requested_at")
  approvedBy  String?  @map("approved_by")
  approvedAt  DateTime? @map("approved_at")

  // ── v2: 법적 증거 필드 ────────────────────────────────────────
  ipAddress  String? @map("ip_address") @db.VarChar(45)  // IPv4/IPv6
  userAgent  String? @map("user_agent") @db.VarChar(500)
  auditedBy  String? @map("audited_by")  // 외부 감사인
  auditedAt  DateTime? @map("audited_at")

  // Relations
  emissionFactor EmissionFactor @relation(fields: [emissionFactorId], references: [id], onDelete: Cascade)

  @@index([emissionFactorId, requestedAt(sort: Asc)])  // 체인 재구성용 (시간순 필수)
  @@index([changeType])
  @@index([requestedBy])
  @@map("emission_factor_audit_log")
}

// ========================================
// COMPLIANCE: 계산 엔진 버전
// ========================================

model CalcEngineVersion {
  id String @id @default(uuid())

  // 버전 정보
  version     String @unique @db.VarChar(20) // 1.0.0
  name        String @db.VarChar(200)
  description String? @db.Text

  // 계산 로직
  methodology String  @db.VarChar(100) // GHG Protocol, ISO 14064, 환경부 MRV
  formula     Json?
  parameters  Json?

  // 상태
  isActive  Boolean   @default(true) @map("is_active")
  releasedAt DateTime @map("released_at")
  deprecatedAt DateTime? @map("deprecated_at")

  // 변경 이력
  changelog String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  emissionsRecords EmissionsRecord[]

  @@index([isActive])
  @@map("calc_engine_version")
}

// ========================================
// API: API 키 관리
