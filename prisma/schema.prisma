  counterparty     String?                      @db.VarChar(200)
  paymentStatus    String                       @default("N/A") @map("payment_status") @db.VarChar(20)
  settlementStatus String                       @default("N/A") @map("settlement_status") @db.VarChar(20)
  idempotencyKey   String?                      @unique @map("idempotency_key") @db.VarChar(128)
  hashSignature    String                       @map("hash_signature") @db.VarChar(64)
  prevHash         String?                      @map("prev_hash") @db.VarChar(64)
  memo             String?                      @db.Text
  metadata         Json?
  createdAt        DateTime                     @default(now()) @map("created_at")
  registry         CarbonCreditRegistry         @relation(fields: [registryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "carbon_ledger_entry_registry_fk")
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carbon_ledger_entry_tenant_fk")
