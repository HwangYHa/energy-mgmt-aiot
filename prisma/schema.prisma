  retirementCert   CarbonRetirementCertificate?

  @@index([registryId], map: "carbon_ledger_entry_registry_idx")
  @@index([tenantId, createdAt(sort: Desc)], map: "carbon_ledger_entry_tenant_created_idx")
  @@index([tenantId, eventType], map: "carbon_ledger_entry_tenant_event_idx")
  @@map("carbon_ledger_entry")
}

