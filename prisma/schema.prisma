// ========================================
// DIGITAL TWIN: 물리 공간 계층
// ========================================

enum SpaceType {
  building
  floor
  zone
  room
  shaft
}

model PhysicalSpace {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  siteId   String @map("site_id")

  // 기본 정보
  name String  @db.VarChar(200)
  code String? @db.VarChar(50)
  type SpaceType

  // 계층 (0=building, 1=floor, 2=zone, 3=room)
  level Int @default(0)

  // 자기참조 부모
  parentId String? @map("parent_id")

  // 평면도 좌표 (선택)
  floorPlanX Decimal? @map("floor_plan_x") @db.Decimal(10, 2)
  floorPlanY Decimal? @map("floor_plan_y") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent    PhysicalSpace?  @relation("SpaceChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  PhysicalSpace[] @relation("SpaceChildren")
  twinNodes TwinNode[]

  @@index([tenantId])
  @@index([siteId, type])
  @@index([parentId])
  @@map("physical_space")
}

// ========================================
// DIGITAL TWIN: 트윈 노드 (Device ↔ 공간 바인딩)
// ========================================

enum SystemType {
  HVAC
  ELECTRICAL
  PLUMBING
  FIRE_SAFETY
  LIGHTING
  MECHANICAL
  OTHER
}

enum EquipClass {
  AHU
  FCU
  CHILLER
  COOLING_TOWER
  BOILER
  PUMP
  FAN
  TRANSFORMER
  UPS
  PANEL
  METER
  SENSOR
  OTHER
}

model TwinNode {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  deviceId String @unique @map("device_id")
  spaceId  String @map("space_id")

  // 설비 분류
  systemType SystemType @map("system_type")
  equipClass EquipClass @map("equip_class")

  // 에너지 토폴로지 (downstream / upstream TwinNode ID 배열)
  feedsIds Json? @map("feeds_ids")
  fedByIds Json? @map("fed_by_ids")

  // 파생 메트릭 정의 (COP, 부하율 등 계산식 JSON)
  computedMetrics Json? @map("computed_metrics")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  space  PhysicalSpace @relation(fields: [spaceId], references: [id])

  @@index([tenantId])
  @@index([spaceId])
  @@index([systemType])
  @@map("twin_node")
}
