generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String                        @id @default(uuid())
  code                   String?                       @unique(map: "code") @db.VarChar(30)
  name                   String                        @db.VarChar(200)
  businessNumber         String?                       @unique @map("business_number") @db.VarChar(50)
  domain                 String?                       @unique @db.VarChar(100)
  industryType           IndustryType                  @default(manufacturing) @map("industry_type")
  address                String?                       @db.Text
  city                   String?                       @db.VarChar(100)
  country                String                        @default("KR") @db.VarChar(50)
  timezone               String                        @default("Asia/Seoul") @db.VarChar(50)
  status                 TenantStatus                  @default(active)
  settings               Json?
  metadata               Json?
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  deletedAt              DateTime?                     @map("deleted_at")
  onboardingCompletedAt  DateTime?                     @map("onboarding_completed_at")
  onboardingStep         Int                           @default(0) @map("onboarding_step")
  activityLogs           ActivityLog[]
  alertRules             AlertRule[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  carbonCredits          CarbonCredit[]
  carbonCreditRegistries CarbonCreditRegistry[]
  carbonLedgerEntries    CarbonLedgerEntry[]
  carbonPayments         CarbonPayment[]
  carbonRetirementCerts  CarbonRetirementCertificate[]
  carbonTokenRecords     CarbonTokenRecord[]
  carbonTrades           CarbonTrade[]
  devices                Device[]
  downloadHistories      DownloadHistory[]
  emissionsRecords       EmissionsRecord[]
  equipmentLots          EquipmentLot[]
  esgReports             ESGReport[]
  forecastresult         forecastresult[]
  gateways               Gateway[]
  loginHistories         LoginHistory[]
  measurements           Measurement[]
  metrics                Metric[]
  milestones             Milestone[]
  notificationRules      NotificationRule[]
  paymentHistories       PaymentHistory[]
  physicalSpaces         PhysicalSpace[]
  report                 report[]
  sensors                Sensor[]
  sites                  Site[]
  subscriptions          Subscription[]
  carbonWallet           TenantCarbonWallet?
  complianceSetting      TenantComplianceSetting?
  twinNodes              TwinNode[]
  users                  User[]
  userSiteAccesses       UserSiteAccess[]

  @@index([status])
  @@index([industryType])
  @@map("tenant")
}

model Plan {
  id                String         @id @default(uuid())
  name              String         @db.VarChar(100)
  tier              PlanTier
  monthlyPrice      Decimal?       @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice       Decimal?       @map("yearly_price") @db.Decimal(12, 2)
  setupFee          Decimal        @default(0.00) @map("setup_fee") @db.Decimal(12, 2)
  maxSites          Int?           @map("max_sites")
  maxDevices        Int?           @map("max_devices")
  maxUsers          Int?           @map("max_users")
  dataRetentionDays Int            @default(90) @map("data_retention_days")
  apiRateLimit      Int            @default(1000) @map("api_rate_limit")
  features          Json
  isActive          Boolean        @default(true) @map("is_active")
  isPublic          Boolean        @default(true) @map("is_public")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  planFeatures      PlanFeature[]
  subscriptions     Subscription[]

  @@map("plan")
}

model Subscription {
  id                        String             @id @default(uuid())
  tenantId                  String             @map("tenant_id")
  planId                    String             @map("plan_id")
  status                    SubscriptionStatus
  startDate                 DateTime           @map("start_date") @db.Date
  endDate                   DateTime           @map("end_date") @db.Date
  trialEndDate              DateTime?          @map("trial_end_date") @db.Date
  paymentStatus             PaymentStatus?     @map("payment_status")
  paymentMethod             String?            @map("payment_method") @db.VarChar(50)
  billingCycle              BillingCycle?      @map("billing_cycle")
  installationScheduledDate DateTime?          @map("installation_scheduled_date") @db.Date
  installationCompletedDate DateTime?          @map("installation_completed_date") @db.Date
  firstDataReceivedAt       DateTime?          @map("first_data_received_at")
  autoRenew                 Boolean            @default(true) @map("auto_renew")
  metadata                  Json?
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  paymentHistories          PaymentHistory[]
  plan                      Plan               @relation(fields: [planId], references: [id])
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([endDate])
  @@index([planId], map: "subscription_plan_id_fkey")
  @@map("subscription")
}

model User {
  id                    String             @id @default(uuid())
  code                  String?            @unique(map: "code") @db.VarChar(30)
  tenantId              String             @map("tenant_id")
  email                 String             @unique @db.VarChar(255)
  passwordHash          String             @map("password_hash") @db.VarChar(255)
  password_changed_at   DateTime?          @db.DateTime(0)
  name                  String             @db.VarChar(100)
  phone                 String?            @db.VarChar(50)
  country               String             @default("KR") @db.VarChar(10)
  city                  String?            @db.VarChar(100)
  role                  UserRole           @default(viewer)
  isActive              Boolean            @default(true) @map("is_active")
  isEmailVerified       Boolean            @default(false) @map("is_email_verified")
  mfaEnabled            Boolean            @default(false) @map("mfa_enabled")
  mfaSecret             String?            @map("mfa_secret") @db.VarChar(255)
  lastLoginAt           DateTime?          @map("last_login_at")
  lastLoginIp           String?            @map("last_login_ip") @db.VarChar(45)
  loginAttempts         Int                @default(0) @map("login_attempts")
  lockedUntil           DateTime?          @map("locked_until")
  refreshToken          String?            @map("refresh_token") @db.VarChar(500)
  refreshTokenExpiresAt DateTime?          @map("refresh_token_expires_at")
  resetToken            String?            @map("reset_token") @db.VarChar(255)
  resetTokenExpiresAt   DateTime?          @map("reset_token_expires_at")
  tokenVersion          Int                @default(0) @map("token_version")
  preferences           Json?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  loginHistories        LoginHistory[]
  menu_access_log       menu_access_log[]
  notificationRules     NotificationRule[]
  report                report[]
  managedSites          Site[]             @relation("SiteManager")
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuFavorites         UserMenuFavorite[]
  siteAccesses          UserSiteAccess[]

  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@map("user")
}

model LoginHistory {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  tenantId   String   @map("tenant_id") @db.VarChar(36)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  provider   String   @default("credentials") @db.VarChar(30)
  success    Boolean  @default(true)
  failReason String?  @map("fail_reason") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_history")
}

/// 사용자별 사이트 접근 권한 (site_manager/operator/viewer 는 반드시 명시적 허용 필요)
model UserSiteAccess {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tenantId  String    @map("tenant_id") @db.VarChar(36)
  siteId    String    @map("site_id") @db.VarChar(36)
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, siteId])
  @@index([tenantId, siteId])
  @@index([siteId], map: "user_site_access_site_id_fkey")
  @@map("user_site_access")
}

model Site {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  name             String           @db.VarChar(200)
  code             String?          @db.VarChar(50)
  address          String?          @db.Text
  city             String?          @db.VarChar(100)
  country          String           @default("KR") @db.VarChar(50)
  latitude         Decimal?         @db.Decimal(10, 8)
  longitude        Decimal?         @db.Decimal(11, 8)
  timezone         String           @default("Asia/Seoul") @db.VarChar(50)
  siteType         SiteType         @default(factory) @map("site_type")
  areaSqm          Decimal?         @map("area_sqm") @db.Decimal(10, 2)
  floors           Int?
  operatingHours   Json?            @map("operating_hours")
  peakPowerKw      Decimal?         @map("peak_power_kw") @db.Decimal(10, 2)
  isActive         Boolean          @default(true) @map("is_active")
  managerId        String?          @map("manager_id")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")
  devices          Device[]
  gateways         Gateway[]
  physicalSpaces   PhysicalSpace[]
  manager          User?            @relation("SiteManager", fields: [managerId], references: [id])
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userSiteAccesses UserSiteAccess[]

  @@index([tenantId])
  @@index([siteType])
  @@index([managerId], map: "site_manager_id_fkey")
  @@map("site")
}

model Gateway {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  siteId             String            @map("site_id")
  serialNumber       String            @unique @map("serial_number") @db.VarChar(100)
  name               String?           @db.VarChar(100)
  model              String?           @db.VarChar(50)
  firmwareVersion    String?           @map("firmware_version") @db.VarChar(20)
  ipAddress          String?           @map("ip_address") @db.VarChar(45)
  macAddress         String?           @map("mac_address") @db.VarChar(17)
  vpnAddress         String?           @map("vpn_address") @db.VarChar(45)
  primaryConnection  GatewayConnection @default(ethernet) @map("primary_connection")
  fallbackConnection GatewayFallback   @default(lte) @map("fallback_connection")
  status             DeviceStatus      @default(offline)
  lastSeenAt         DateTime?         @map("last_seen_at")
  lastHeartbeatAt    DateTime?         @map("last_heartbeat_at")
  bufferSizeMb       Int               @default(100) @map("buffer_size_mb")
  bufferedRecords    Int               @default(0) @map("buffered_records")
  config             Json?
  ownership          GatewayOwnership  @default(company)
  installationDate   DateTime?         @map("installation_date") @db.Date
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  code               String?           @db.VarChar(50)
  devices            Device[]
  site               Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  measurements       Measurement[]

  @@index([tenantId])
  @@index([siteId])
  @@index([status])
  @@map("gateway")
}

model Device {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  siteId           String         @map("site_id")
  gatewayId        String?        @map("gateway_id")
  name             String         @db.VarChar(200)
  code             String?        @db.VarChar(50)
  deviceType       String         @map("device_type") @db.VarChar(50)
  manufacturer     String?        @db.VarChar(100)
  model            String?        @db.VarChar(100)
  protocol         DeviceProtocol
  connectionConfig Json           @map("connection_config")
  controlCapable   Boolean        @default(false) @map("control_capable")
  controlMode      ControlMode    @default(disabled) @map("control_mode")
  status           DeviceStatus   @default(offline)
  lastSeenAt       DateTime?      @map("last_seen_at")
  pollIntervalMs   Int            @default(5000) @map("poll_interval_ms")
  responseTimeMs   Int?           @map("response_time_ms")
  installationDate DateTime?      @map("installation_date") @db.Date
  warrantyEndDate  DateTime?      @map("warranty_end_date") @db.Date
  location         String?        @db.VarChar(200)
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  gateway          Gateway?       @relation(fields: [gatewayId], references: [id])
  site             Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metrics          Metric[]
  sensors          Sensor[]
  twinNode         TwinNode?

  @@index([tenantId])
  @@index([siteId])
  @@index([gatewayId])
  @@index([deviceType])
  @@index([status])
  @@map("device")
}

model Metric {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  deviceId        String         @map("device_id")
  key             String         @db.VarChar(100)
  name            String?        @db.VarChar(200)
  dataType        DataType       @default(float) @map("data_type")
  unit            String?        @db.VarChar(20)
  registerAddress Int?           @map("register_address")
  registerType    RegisterType?  @map("register_type")
  scaleFactor     Decimal        @default(1.000000) @map("scale_factor") @db.Decimal(10, 6)
  minValue        Decimal?       @map("min_value") @db.Decimal(15, 4)
  maxValue        Decimal?       @map("max_value") @db.Decimal(15, 4)
  accessLevel     AccessLevel    @default(read) @map("access_level")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  sensorId        String?        @map("sensor_id")
  category        MetricCategory @default(other)
  measurements    Measurement[]
  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor          Sensor?        @relation(fields: [sensorId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
  @@index([tenantId])
  @@index([sensorId])
  @@index([key])
  @@index([tenantId, category])
  @@map("metric")
}

model Measurement {
  time       DateTime
  tenantId   String      @map("tenant_id")
  metricId   String      @map("metric_id")
  value      Decimal     @db.Decimal(15, 4)
  quality    DataQuality @default(good)
  source     DataSource  @default(sensor)
  gatewayId  String?     @map("gateway_id")
  receivedAt DateTime    @default(now()) @map("received_at")
  gateway    Gateway?    @relation(fields: [gatewayId], references: [id])
  metric     Metric      @relation(fields: [metricId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([metricId, time])
  @@index([tenantId, time(sort: Desc)])
  @@index([gatewayId, time(sort: Desc)])
  @@map("measurement")
}

model AlertRule {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  name        String        @db.VarChar(200)
  description String?       @db.Text
  category    AlertCategory
  severity    AlertSeverity
  scope       AlertScope
  scopeId     String?       @map("scope_id")
  condition   Json
  channels    Json?
  recipients  Json?
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  code        String?       @db.VarChar(50)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([enabled])
  @@map("alert_rule")
}

model AuditLog {
  id           String       @id @default(uuid())
  tenantId     String?      @map("tenant_id")
  userId       String?      @map("user_id")
  action       String       @db.VarChar(100)
  resourceType String?      @map("resource_type") @db.VarChar(50)
  resourceId   String?      @map("resource_id")
  changes      Json?
  result       AuditResult?
  errorMessage String?      @map("error_message") @db.Text
  ipAddress    String?      @map("ip_address") @db.VarChar(45)
  userAgent    String?      @map("user_agent") @db.Text
  requestId    String?      @map("request_id")
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([action(length: 30), ipAddress, createdAt], map: "idx_audit_log_security")
  @@map("audit_log")
}

model MenuGroup {
  id                    String     @id @default(uuid())
  code                  String     @unique @db.VarChar(50)
  name                  String     @db.VarChar(100)
  icon                  String?    @db.VarChar(50)
  displayOrder          Int        @default(0) @map("display_order")
  level                 Int        @default(1)
  minRole               UserRole   @default(viewer) @map("min_role")
  subscriptionRequired  Boolean    @default(true) @map("subscription_required")
  minSubscriptionStatus String?    @map("min_subscription_status") @db.VarChar(50)
  isActive              Boolean    @default(true) @map("is_active")
  isVisible             Boolean    @default(true) @map("is_visible")
  description           String?    @db.Text
  metadata              Json?
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  menuItems             MenuItem[]

  @@index([isActive, displayOrder])
  @@index([minRole])
  @@map("menu_group")
}

model MenuItem {
  id                    String             @id @default(uuid())
  code                  String             @unique @db.VarChar(50)
  name                  String             @db.VarChar(100)
  icon                  String?            @db.VarChar(50)
  path                  String?            @db.VarChar(200)
  externalUrl           String?            @map("external_url") @db.VarChar(500)
  menuGroupId           String?            @map("menu_group_id")
  parentId              String?            @map("parent_id")
  displayOrder          Int                @default(0) @map("display_order")
  level                 Int                @default(1)
  minRole               UserRole           @default(viewer) @map("min_role")
  allowedRoles          Json?              @map("allowed_roles")
  subscriptionRequired  Boolean            @default(true) @map("subscription_required")
  minSubscriptionStatus String?            @map("min_subscription_status") @db.VarChar(50)
  featureRequired       String?            @map("feature_required") @db.VarChar(100)
  isActive              Boolean            @default(true) @map("is_active")
  isVisible             Boolean            @default(true) @map("is_visible")
  badgeType             BadgeType          @default(none) @map("badge_type")
  badgeColor            String?            @map("badge_color") @db.VarChar(20)
  description           String?            @db.Text
  metadata              Json?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  menu_access_log       menu_access_log[]
  menuGroup             MenuGroup?         @relation(fields: [menuGroupId], references: [id], onDelete: Cascade)
  parent                MenuItem?          @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children              MenuItem[]         @relation("MenuItemChildren")
  favorites             UserMenuFavorite[]

  @@index([menuGroupId, displayOrder])
  @@index([parentId, displayOrder])
  @@index([isActive, isVisible])
  @@index([minRole])
  @@map("menu_item")
}

model UserMenuFavorite {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  menuItemId   String   @map("menu_item_id")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId, displayOrder])
  @@index([menuItemId], map: "user_menu_favorite_menu_item_id_fkey")
  @@map("user_menu_favorite")
}

model ControlLog {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  deviceId         String        @map("device_id")
  action           String        @db.VarChar(100)
  parameters       Json?
  targetValue      Decimal?      @map("target_value") @db.Decimal(15, 4)
  actualValue      Decimal?      @map("actual_value") @db.Decimal(15, 4)
  status           ControlStatus @default(pending)
  requiresApproval Boolean       @default(false) @map("requires_approval")
  approvedBy       String?       @map("approved_by")
  approvedAt       DateTime?     @map("approved_at")
  executedBy       String        @map("executed_by")
  executionMode    ExecutionMode @map("execution_mode")
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  requestedAt      DateTime      @default(now()) @map("requested_at")
  reason           String?       @map("reason") @db.Text

  @@index([tenantId, requestedAt(sort: Desc)])
  @@index([deviceId, requestedAt(sort: Desc)])
  @@index([executedBy])
  @@map("control_log")
}

model DrEvent {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  title             String        @db.VarChar(200)
  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  targetReductionKw Decimal       @map("target_reduction_kw") @db.Decimal(10, 2)
  actualReductionKw Decimal?      @map("actual_reduction_kw") @db.Decimal(10, 2)
  revenue           Decimal?      @db.Decimal(12, 2)
  status            DrEventStatus @default(scheduled)
  createdAt         DateTime      @default(now()) @map("created_at")
  code              String?       @db.VarChar(50)

  @@index([tenantId, startTime])
  @@index([status])
  @@map("dr_event")
}

model EmissionsData {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  deviceId           String?           @map("device_id")
  emissionType       EmissionType      @map("emission_type")
  sourceType         String            @map("source_type") @db.VarChar(50)
  amount             Decimal           @db.Decimal(15, 3)
  unit               String            @db.VarChar(20)
  emissionFactor     Decimal           @map("emission_factor") @db.Decimal(10, 6)
  calculatedEmission Decimal           @map("calculated_emission") @db.Decimal(15, 3)
  period             String            @db.VarChar(7)
  calculationMethod  CalculationMethod @default(manual) @map("calculation_method")
  dataSource         DataSourceType    @default(MANUAL) @map("data_source")
  createdAt          DateTime          @default(now()) @map("created_at")
  code               String?           @db.VarChar(50)

  @@index([tenantId, period])
  @@index([emissionType])
  @@map("emissions_data")
}

model RegulationReport {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  reportType     String       @map("report_type") @db.VarChar(50)
  reportName     String       @map("report_name") @db.VarChar(200)
  period         String       @db.VarChar(7)
  status         ReportStatus @default(draft)
  dueDate        DateTime     @map("due_date") @db.Date
  submittedDate  DateTime?    @map("submitted_date")
  submittedBy    String?      @map("submitted_by")
  approvedDate   DateTime?    @map("approved_date")
  approvedBy     String?      @map("approved_by")
